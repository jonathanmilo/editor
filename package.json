{
  "name": "maquina-de-escribir",
  "productName": "Máquina de escribir",
  "version": "1.2.0",
  "description": "Editor de texto de escritorio con modo máquina de escribir",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/editor/editor.js --bundle --format=iife --minify --target=chrome120 --outfile=src/vendor/editor.js",
    "prestart": "npm run build",
    "start": "electron .",
    "predist": "npm run build",
    "dist": "electron-builder",
    "predist:win": "npm run build",
    "dist:win": "electron-builder --win"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "docx": "^9.15.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "app.maquinadeescribir",
    "productName": "Máquina de escribir",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "!src/editor/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Documento de Word",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "Documento PDF",
        "role": "Viewer"
      },
      {
        "ext": "txt",
        "name": "Texto",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor"
      }
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ]
  }
}
